<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app install its own updates downloaded from GitHub (asked once). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".SatoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/SatoTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:taskAffinity="fr.satodce.app.profile0"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Return from the Google sign-in done in the phone browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="satodce" android:host="login" />
            </intent-filter>
        </activity>
        <activity android:name=".ProfileOneActivity" android:taskAffinity="fr.satodce.app.profile1" android:process=":profile1" android:exported="false" android:launchMode="singleTask" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ProfileTwoActivity" android:taskAffinity="fr.satodce.app.profile2" android:process=":profile2" android:exported="false" android:launchMode="singleTask" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ProfileThreeActivity" android:taskAffinity="fr.satodce.app.profile3" android:process=":profile3" android:exported="false" android:launchMode="singleTask" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
